                                                        "type": "string"
                                                    },
                                                    "minItems": 0,
                                                    "maxItems": 0
                                                },
                                                "status": {
                                                    "type": "integer",
                                                    "const": 200
                                                }
                                            },
                                            "required": [
                                                "success",
