                                                },
                                                "status": {
                                                    "type": "integer",
                                                    "const": 500
                                                }
                                            },
                                            "required": [
                                                "success",
                                                "data",
                                                "status"
                                            ]
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "success": {
                                                    "type": "boolean"
                                                },
                                                "message": {
                                                    "type": "string",
                                                    "const": "Profile fetched successfully"
                                                },
                                                "data": {
                                                    "type": [
                                                        "object",
                                                        "null"
                                                    ]
                                                },
                                                "status": {
                                                    "type": "integer",
                                                    "const": 200
                                                }
                                            },
                                            "required": [
                                                "success",
                                                "message",
                                                "data",
                                                "status"
                                            ]
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
